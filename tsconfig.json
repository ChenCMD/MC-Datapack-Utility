{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2021",
		"outDir": "out",
		"lib": [
			"ES2021"
		],
		"sourceMap": true,
		"rootDir": "src",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"moduleResolution": "Node16",
		"types": [
			"node",
			"vscode"
		]
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
	"include": [
		"src/**/*.json",
		"src/**/*.ts"
	]
}
